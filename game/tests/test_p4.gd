extends SceneTree
## P4 headless system and regression checks. Anonymous QA applicants only.
const WorldState = preload("res://scripts/world/world_state.gd")
const GateSystem = preload("res://scripts/gate/gate_system.gd")
const SaveStore = preload("res://scripts/world/save_store.gd")

var checks: int = 0
var failures: Array[String] = []

func expect(condition: bool, title: String) -> void:
    checks += 1
    if not condition:
        failures.append(title)
        push_error(title)

func _initialize() -> void:
    var world := WorldState.new()
    var initial: Dictionary = world.snapshot()
    expect(WorldState.validate_state(initial).is_empty(), "P4 initial world validates")
    expect(not initial["gate"]["started"], "gate initially unopened")
    expect(initial["characters"].size() == 5, "no new canonical characters")
    expect(not world.decide_gate("authorized", "valid_pass"), "cannot decide without an active case")
    expect(not world.finish_gate(true), "cannot finish unopened gate")
    expect(world.begin_gate(), "opening gate shift")
    var gate: Dictionary = world.state["gate"]
    var clock: Dictionary = world.state["shift_clock"]
    expect(gate["started"] and not gate["complete"], "gate active")
    expect(world.state["qa_mode"], "anonymous QA provenance flagged")
    expect(world.state["calendar"]["phase"] == "daytime", "gate opens daytime")
    expect(world.current_duty() == "gate", "approved weekly rotation intact")
    expect(gate["queue"].size() == 6, "routine and investigative fixture cases loaded")
    expect(world.state["characters"].size() == 12, "seven anonymous QA subjects including cub plus five canonical people")
    var anonymous_names_ok := true
    for id in world.state["characters"].keys():
        if str(id).begins_with("uc.qa."):
            anonymous_names_ok = anonymous_names_ok and world.state["characters"][id]["display_name"] == ""
    expect(anonymous_names_ok, "no names invented for training applicants")
    expect(int(clock["duration_seconds"]) == GateSystem.QA_SHIFT_SECONDS, "provisional shift duration clearly separate")
    expect(not world.begin_gate(), "cannot re-open active shift and duplicate QA cases")
    expect(not world.show_gate_document("unknown"), "invalid document view rejected")
    expect(world.show_gate_document("pass"), "paper can be opened")
    expect(clock["pause_reasons"].has("reading_documents"), "paper reading pauses shift clock")
    expect(world.tick_shift(20.0) and float(clock["elapsed_seconds"]) == 0.0, "paper does not consume shift timer")
    expect(world.show_gate_document("summary"), "close document")
    expect(clock["pause_reasons"].is_empty(), "closing papers resumes timer")
    expect(world.tick_shift(10.0) and float(clock["elapsed_seconds"]) == 10.0, "shift clock advances when working")
    world.set_shift_timer_enabled(false)
    expect(world.tick_shift(100.0) and float(clock["elapsed_seconds"]) == 10.0, "unlimited timer does not tick")
    world.set_shift_timer_enabled(true)
    expect(not world.ask_gate("bribe"), "unlisted question rejected")
    expect(not world.verify_gate("magic"), "unlisted verification rejected")
    expect(world.ask_gate("purpose"), "can ask purpose")
    expect(world.ask_gate("purpose") and gate["asked"].size() == 1, "repeat inquiry does not create duplicate query code")
    expect(world.verify_gate("registry"), "can call registry")
    expect(world.verify_gate("registry") and gate["verified"].size() == 1, "repeat verification code deduplicated")
    var first: Dictionary = GateSystem.current(world)
    var first_subject: String = first["subject_id"]
    expect(not world.decide_gate("unknown", "valid_pass"), "unsupported decision status rejected")
    expect(not world.decide_gate("authorized", "no_reason"), "unsupported reason rejected")
    expect(world.decide_gate("authorized", "valid_pass"), "routine valid case authorized")
    expect(world.state["entry_permissions"][first_subject]["status"] == "authorized", "authorization recorded in P2 entry state")
    expect(world.state["refuge_placements"].is_empty(), "entry does not place applicant in refuge")
    expect(world.state["guardian_links"]["uc.family.button"]["guardian_id"] == "uc.family.mama", "gate does not change family guardian")
    expect(gate["decisions"][0]["matches_training_rule"], "training audit recognizes reasoned authorization")
    expect(gate["asked"].is_empty() and gate["verified"].is_empty(), "questions cleared on next case")
    expect(world.decide_gate("denied", "expired_pass"), "expired pass denied")
    expect(gate["decisions"][1]["matches_training_rule"], "valid expiration reason recognized")
    expect(gate["cursor"] == 2, "two decisions advance queue")
    expect(world.verify_gate("registry"), "identity verification")
    expect(world.decide_gate("held", "identity_unverified"), "mismatch placed on hold")
    expect(gate["decisions"][2]["matches_training_rule"], "hold supported by evidence")
    expect(world.verify_gate("guardian"), "guardian records checked")
    expect(world.decide_gate("held", "guardian_unverified"), "unverified caregiver held")
    expect(gate["decisions"][3]["matches_training_rule"], "separate guardian inquiry correctly audited")
    expect(world.state["temporary_care"].is_empty(), "gate never grants temporary care")
    expect(world.decide_gate("denied", "valid_pass"), "imperfect player decision still persistently recorded")
    expect(not gate["decisions"][4]["matches_training_rule"], "incorrect decision does not get falsely praised")
    expect(gate["cursor"] == 5, "last investigative case remains")
    expect(not world.decide_gate("authorized", "registry_exception"), "exception requires actual registry call")
    expect(world.verify_gate("registry"), "registry extension verified")
    expect(world.decide_gate("authorized", "registry_exception"), "confirmed exception authorizes entry")
    expect(gate["complete"], "queue completion ends shift")
    expect(gate["cursor"] == gate["queue"].size(), "all six cases decided")
    expect(world.state["calendar"]["phase"] == "evening", "work shift returns to evening")
    expect(not clock["running"], "shift clock stopped")
    expect(gate["skipped"].is_empty(), "full shift has zero skipped cases")
    expect(not world.decide_gate("authorized", "valid_pass"), "no decisions after completing shift")
    expect(not world.begin_gate(), "no replay of completed gate workday")
    expect(world.state["financials"]["ledgers"]["household"]["balance_hm"] == null, "no invented wage payments")
    expect(world.state["financials"]["ledgers"]["refuge"]["balance_hm"] == null, "no invented refuge balance")
    expect(world.state["home"]["cubs"].size() == 2, "home state intact after workday")
    expect(WorldState.validate_state(world.snapshot()).is_empty(), "world validates after six decisions")
    var path := "user://uc_p4_test.json"
    DirAccess.remove_absolute(ProjectSettings.globalize_path(path))
    DirAccess.remove_absolute(ProjectSettings.globalize_path(path + ".bak"))
    expect(bool(SaveStore.save_document(path, world.snapshot()).get("ok", false)), "P4 save created")
    var loaded := WorldState.new()
    expect(bool(SaveStore.load_into(path, loaded).get("ok", false)), "P4 save restores into new world")
    expect(WorldState.validate_state(loaded.snapshot()).is_empty(), "loaded P4 data validates")
    expect(loaded.state["gate"]["decisions"].size() == 6, "all decisions survive save/load")
    expect(loaded.state["entry_permissions"].size() == 7, "separate party legal entry results survive save/load")
    expect(loaded.state["calendar"]["phase"] == "evening", "completed shift phase survives save/load")
    expect(loaded.state["guardian_links"]["uc.family.hazel"]["guardian_id"] == "uc.family.mama", "guardian protected through save/load")
    var tampered: Dictionary = world.snapshot()
    tampered["gate"]["cursor"] = 0
    expect(not WorldState.validate_state(tampered).is_empty(), "corrupt cursor caught")
    var missing_subject: Dictionary = world.snapshot()
    missing_subject["characters"].erase(str(gate["queue"][0]["subject_id"]))
    expect(not WorldState.validate_state(missing_subject).is_empty(), "missing persistent applicant caught")
    var changed_legal: Dictionary = world.snapshot()
    changed_legal["entry_permissions"][first_subject]["status"] = "denied"
    expect(not WorldState.validate_state(changed_legal).is_empty(), "tampered legal decision caught")
    var altered_truth: Dictionary = world.snapshot()
    altered_truth["gate"]["queue"][0]["expected_status"] = "denied"
    expect(not WorldState.validate_state(altered_truth).is_empty(), "training rule truth cannot be edited in save")
    var altered_audit: Dictionary = world.snapshot()
    altered_audit["gate"]["decisions"][4]["matches_training_rule"] = true
    expect(not WorldState.validate_state(altered_audit).is_empty(), "audit success cannot be forged")
    var fake_result: Dictionary = world.snapshot()
    fake_result["gate"]["decisions"][0]["reason"] = "guardian_unverified"
    expect(not WorldState.validate_state(fake_result).is_empty(), "case/decision mismatch rejected")
    var unproven_qa: Dictionary = world.snapshot()
    unproven_qa["qa_mode"] = false
    expect(not WorldState.validate_state(unproven_qa).is_empty(), "QA subjects require explicit QA provenance")
    var early := WorldState.new()
    expect(early.begin_gate(), "alternate shift begins")
    expect(early.decide_gate("authorized", "valid_pass"), "one case completed in early shift")
    expect(early.finish_gate(true), "early shift recorded")
    expect(early.state["gate"]["skipped"].size() == 5, "unprocessed cases logged, not magically denied")
    expect(early.state["entry_permissions"].size() == 1, "only decided applicant received entry status")
    expect(WorldState.validate_state(early.snapshot()).is_empty(), "early shift save validates")
    expect(early.advance_day() and early.current_duty() == "refuge", "next day is refuge; P5 not simulated")
    print("P4 HEADLESS: ", checks, " checks, ", failures.size(), " failures")
    quit(0 if failures.is_empty() else 1)
