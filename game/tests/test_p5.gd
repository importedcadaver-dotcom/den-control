extends SceneTree
## P5 cross-day gate, refuge, custody, public budget and save/load tests.
const WorldState = preload("res://scripts/world/world_state.gd")
const SaveStore = preload("res://scripts/world/save_store.gd")
var checks := 0
var failures: Array[String] = []

func expect(ok: bool, label: String) -> void:
    checks += 1
    if not ok:
        failures.append(label)
        push_error(label)

func _initialize() -> void:
    var w = WorldState.new()
    expect(WorldState.validate_state(w.snapshot()).is_empty(), "initial state validates")
    expect(not w.begin_refuge(), "no refuge on gate duty")
    expect(w.begin_gate(), "day one gate")
    expect(w.decide_gate("authorized", "valid_pass"), "first QA entry approved")
    expect(w.decide_gate("denied", "expired_pass"), "second denied")
    expect(w.decide_gate("held", "identity_unverified"), "third held")
    expect(w.decide_gate("held", "guardian_unverified"), "fourth held without invented custody")
    expect(w.decide_gate("authorized", "valid_pass"), "fifth authorized")
    expect(w.verify_gate("registry"), "registry exception checked")
    expect(w.decide_gate("authorized", "registry_exception"), "sixth authorized")
    expect(w.state["gate"]["complete"], "gate shift complete")
    expect(w.advance_day(), "advance to refuge day")
    expect(w.current_duty() == "refuge", "refuge scheduled")
    expect(w.begin_refuge(), "refuge shift begins")
    var r: Dictionary = w.state["refuge"]
    expect(r["started"] and not r["complete"], "refuge running")
    var choices: Array = w.eligible_refuge_subjects()
    expect(choices.size() == 3, "three authorized QA adults")
    var first: Dictionary = choices[0]
    expect(not w.admit_refuge_subject(first["subject_id"], "qa.fake"), "unrelated case rejected")
    expect(w.admit_refuge_subject(first["subject_id"], first["case_id"]), "first resident placed")
    expect(r["residents"].size() == 1, "one occupied bed")
    expect(w.state["refuge_placements"][first["subject_id"]]["status"] == "placed", "separate legal placement recorded")
    expect(not w.admit_refuge_subject(first["subject_id"], first["case_id"]), "no duplicate resident")
    expect(not w.admit_refuge_subject(choices[1]["subject_id"], choices[1]["case_id"]), "no second person without bed")
    expect(w.state["guardian_links"]["uc.family.hazel"]["guardian_id"] == "uc.family.mama", "custody untouched")
    expect(not w.buy_refuge_supply("food"), "unconfigured budget refuses purchase")
    expect(not w.care_refuge_subject(first["subject_id"], "feed"), "no free food")
    expect(w.configure_opening_balance("refuge", 80), "seed QA public budget explicitly")
    expect(w.state["financials"]["ledgers"]["household"]["balance_hm"] == null, "private funds not seeded")
    expect(w.buy_refuge_supply("food"), "buy food with public funds")
    expect(w.state["financials"]["ledgers"]["refuge"]["balance_hm"] == 75, "food charged exactly once")
    expect(r["supplies"]["food"] == 3, "three test portions stocked")
    var hunger: int = r["residents"][first["subject_id"]]["hunger"]
    expect(w.care_refuge_subject(first["subject_id"], "feed"), "hands-on feeding")
    expect(r["supplies"]["food"] == 2, "one portion consumed")
    expect(int(r["residents"][first["subject_id"]]["hunger"]) < hunger, "feeding reduces hunger")
    expect(w.care_refuge_subject(first["subject_id"], "comfort"), "comfort care")
    expect(w.care_refuge_subject(first["subject_id"], "rest"), "rest at bed")
    expect(not w.care_refuge_subject(first["subject_id"], "treat"), "medical supply needed")
    expect(w.buy_refuge_supply("medicine"), "purchase medicine")
    expect(w.care_refuge_subject(first["subject_id"], "treat"), "provide medical care")
    expect(w.buy_refuge_supply("bed"), "buy second bed")
    expect(w.admit_refuge_subject(choices[1]["subject_id"], choices[1]["case_id"]), "second resident")
    expect(not w.admit_refuge_subject(choices[2]["subject_id"], choices[2]["case_id"]), "capacity enforced")
    expect(w.buy_refuge_supply("bed"), "buy third bed")
    expect(w.admit_refuge_subject(choices[2]["subject_id"], choices[2]["case_id"]), "third resident")
    expect(not w.buy_refuge_supply("bed"), "no fourth bed beyond capacity")
    expect(r["residents"].size() == 3, "three persistent residents")
    expect(r["care_log"].size() == 4, "four recorded care actions")
    hunger = int(r["residents"][first["subject_id"]]["hunger"])
    expect(w.tick_refuge(3), "autonomous refuge steps")
    expect(int(r["residents"][first["subject_id"]]["hunger"]) > hunger, "needs change autonomously")
    var home_steps: int = int(w.state["home"]["sim_steps"])
    expect(w.tick_shift(91.0), "world time advances at refuge")
    expect(int(w.state["home"]["sim_steps"]) > home_steps, "offscreen cub behavior progresses")
    expect(WorldState.validate_state(w.snapshot()).is_empty(), "full world validates")
    var path := "user://uc_p5_test_save.json"
    DirAccess.remove_absolute(ProjectSettings.globalize_path(path))
    DirAccess.remove_absolute(ProjectSettings.globalize_path(path + ".bak"))
    expect(bool(SaveStore.save_document(path, w.snapshot()).get("ok", false)), "save gate/refuge/family")
    var loaded = WorldState.new()
    expect(bool(SaveStore.load_into(path, loaded).get("ok", false)), "restore complete world")
    expect(loaded.state["refuge"]["residents"].size() == 3, "residents survive load")
    expect(loaded.state["gate"]["decisions"].size() == 6, "gate decisions survive load")
    expect(loaded.state["home"]["cubs"].size() == 2, "family survives load")
    var damaged: Dictionary = w.snapshot()
    damaged["refuge"]["residents"][first["subject_id"]]["case_id"] = "qa.fake"
    expect(not WorldState.validate_state(damaged).is_empty(), "tampered resident case rejected")
    damaged = w.snapshot()
    damaged["refuge"]["residents"][choices[1]["subject_id"]]["bed"] = 1
    expect(not WorldState.validate_state(damaged).is_empty(), "bed collision rejected")
    damaged = w.snapshot()
    damaged["refuge"]["supplies"]["food"] = -1
    expect(not WorldState.validate_state(damaged).is_empty(), "negative supplies rejected")
    damaged = w.snapshot()
    damaged["financials"]["ledgers"]["refuge"]["balance_hm"] = 99999
    expect(not WorldState.validate_state(damaged).is_empty(), "public ledger tampering rejected")
    expect(w.finish_refuge(), "refuge shift closes")
    expect(w.state["calendar"]["phase"] == "evening", "evening family time")
    expect(not w.finish_refuge(), "duplicate closure blocked")
    expect(w.advance_day() and w.current_duty() == "gate", "next scheduled gate day")
    print("P5 HEADLESS: ", checks, " checks, ", failures.size(), " failures")
    quit(0 if failures.is_empty() else 1)
