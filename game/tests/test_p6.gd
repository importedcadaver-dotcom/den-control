extends SceneTree
## P6: two-day gate/refuge/home continuity, recorded school/Grandma windows, v6 save upgrade.
const WorldState = preload("res://scripts/world/world_state.gd")
const SaveStore = preload("res://scripts/world/save_store.gd")

var checks: int = 0
var failures: Array[String] = []
func expect(ok: bool, label: String) -> void:
    checks += 1
    if not ok:
        failures.append(label)
        push_error(label)

func _initialize() -> void:
    var w = WorldState.new()
    expect(WorldState.validate_state(w.snapshot()).is_empty(), "P6 starts valid")
    expect(w.state["family_schedule"]["window"] == "mama_home", "morning Mama home")
    expect(w.state["guardian_links"]["uc.family.button"]["guardian_id"] == "uc.family.mama", "Mama is legal parent")
    expect(w.begin_gate(), "first gate shift")
    expect(w.state["family_schedule"]["window"] == "preschool", "school starts on scheduled workday")
    expect(w.state["family_schedule"]["caregiver_id"] == "", "teacher not invented")
    expect(w.tick_shift(599.0), "advance school window")
    expect(w.state["family_schedule"]["window"] == "preschool", "before QA half-day threshold")
    expect(w.tick_shift(2.0), "advance past half-day threshold")
    expect(w.state["family_schedule"]["window"] == "grandma_after_preschool", "Grandma scheduled after preschool")
    expect(w.state["family_schedule"]["caregiver_id"] == "uc.family.grandma", "known Grandma only")
    expect(w.state["guardian_links"]["uc.family.hazel"]["guardian_id"] == "uc.family.mama", "scheduled care cannot change guardianship")
    expect(w.state["family_schedule"]["history"].size() == 2, "school-to-Grandma transitions recorded")
    expect(not w.tick_shift(INF), "infinite time rejected")
    expect(not w.tick_shift(-1.0), "negative time rejected")
    expect(w.decide_gate("authorized", "valid_pass"), "authorized anonymous QA person")
    var saved_case: String = str(w.state["gate"]["decisions"][0]["case_id"])
    var saved_person: String = str(w.state["gate"]["decisions"][0]["subject_id"])
    expect(w.finish_gate(true), "finish first gate shift early")
    expect(w.state["family_schedule"]["window"] == "mama_home", "evening Mama home")
    expect(w.state["family_schedule"]["caregiver_id"] == "uc.family.mama", "Mama returns without custody change")
    expect(w.advance_day() and w.current_duty() == "refuge", "second day refuge schedule")
    expect(w.state["family_schedule"]["school_status"] == "not_started", "new-day school reset")
    expect(w.begin_refuge(), "refuge opens second workday")
    expect(w.state["family_schedule"]["window"] == "preschool", "preschool scheduled before refuge")
    expect(w.eligible_refuge_subjects().size() == 1, "only individually authorized person eligible")
    expect(w.admit_refuge_subject(saved_person, saved_case), "separate bed placement after authorization")
    expect(w.state["refuge_placements"][saved_person]["status"] == "placed", "refuge status persists")
    expect(w.state["guardian_links"]["uc.family.button"]["guardian_id"] == "uc.family.mama", "refuge does not alter family")
    expect(not w.buy_refuge_supply("food"), "unconfigured public budget blocks spending")
    expect(w.configure_opening_balance("refuge", 80), "explicit QA-only public money")
    expect(w.buy_refuge_supply("food"), "purchase tracked in public ledger")
    expect(w.care_refuge_subject(saved_person, "feed"), "refuge feed consumes stock")
    expect(w.state["financials"]["ledgers"]["household"]["balance_hm"] == null, "public transaction leaves private money unset")
    expect(w.tick_shift(601.0), "refuge world-time passes school threshold")
    expect(w.state["family_schedule"]["window"] == "grandma_after_preschool", "same childcare pattern on refuge day")
    expect(WorldState.validate_state(w.snapshot()).is_empty(), "two-day work state valid")
    expect(w.finish_refuge(), "refuge completes")
    expect(not w.buy_refuge_supply("food"), "cannot buy after shift closes")
    expect(not w.care_refuge_subject(saved_person, "comfort"), "cannot care after shift closes")
    expect(not w.tick_refuge(1), "resident autonomous tick stops outside shift")
    expect(w.state["family_schedule"]["window"] == "mama_home", "evening returns to Mama")
    var path: String = "user://uc_p6_test_save.json"
    DirAccess.remove_absolute(ProjectSettings.globalize_path(path))
    DirAccess.remove_absolute(ProjectSettings.globalize_path(path + ".bak"))
    expect(bool(SaveStore.save_document(path, w.snapshot()).get("ok", false)), "save complete two-day world")
    var restored = WorldState.new()
    expect(bool(SaveStore.load_into(path, restored).get("ok", false)), "load two-day world")
    expect(restored.state["family_schedule"]["history"].size() >= 4, "care windows survive reload")
    expect(restored.state["refuge"]["residents"].has(saved_person), "resident survives reload")
    expect(restored.state["gate"]["decisions"][0]["case_id"] == saved_case, "gate evidence survives reload")
    var altered: Dictionary = w.snapshot()
    altered["family_schedule"]["caregiver_id"] = "uc.qa.fake"
    expect(not WorldState.validate_state(altered).is_empty(), "unapproved caregiver tampering rejected")
    altered = w.snapshot()
    altered["family_schedule"]["day_index"] = 999
    expect(not WorldState.validate_state(altered).is_empty(), "family schedule day tamper rejected")
    var old: Dictionary = w.snapshot()
    old["schema_version"] = 6
    old.erase("family_schedule")
    var legacy: String = "user://uc_p6_legacy_v6.json"
    var file: FileAccess = FileAccess.open(legacy, FileAccess.WRITE)
    file.store_string(JSON.stringify(old, "  "))
    file.close()
    var migrated = WorldState.new()
    expect(bool(SaveStore.load_into(legacy, migrated).get("ok", false)), "v6 developer save upgrades")
    expect(migrated.state["family_schedule"]["school_status"] == "unverified", "no invented retrospective school report")
    expect(migrated.state["refuge"]["residents"].has(saved_person), "v6 upgrade preserves resident")
    expect(WorldState.validate_state(migrated.snapshot()).is_empty(), "migrated world validates")
    expect(w.advance_day() and w.current_duty() == "gate", "third day returns gate")
    expect(w.begin_gate(), "third-day gate shift starts")
    expect(w.state["gate"]["history"].size() == 1, "previous gate day archived")
    expect(w.state["case_records"].has(saved_case), "old case record remains")
    expect(WorldState.validate_state(w.snapshot()).is_empty(), "new gate still valid")
    print("P6 HEADLESS: ", checks, " checks, ", failures.size(), " failures")
    quit(0 if failures.is_empty() else 1)
